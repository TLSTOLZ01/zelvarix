{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/$1" },
    { "source": "/compare/apollo-alternative", "destination": "/compare/apollo-alternative.html" },
    { "source": "/compare/zoominfo-alternative", "destination": "/compare/zoominfo-alternative.html" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
